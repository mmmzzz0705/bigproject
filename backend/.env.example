# ================= 基础配置 =================
APP_NAME=政务智能问答与办事引导系统
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# ================= 数据库 =================
# DB_TYPE: auto（填了 DB_HOST 就用关系库）| postgresql | mysql | sqlite
# 默认 PostgreSQL；关系库不可达时自动降级为本地 SQLite，保证服务可启动
DB_TYPE=postgresql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=123456
DB_NAME=gov_qa
DB_CHARSET=utf8mb4
SQLITE_PATH=data/app.db

# ================= AI 应用层 =================
# native    = 自研检索/生成实现（默认，零依赖）
# langchain = 使用 LangChain 的 Loader / TextSplitter / Retriever / LCEL 链
PIPELINE=native

# ================= 向量库 =================
# milvus = Milvus（推荐，支撑百万级片段）
# chroma = Chroma；memory = 本地 numpy 向量库（零依赖，仅演示）
VECTOR_STORE=milvus
# 向量维度必须与 Embedding 模型一致：hash/text-embedding-v3=1024，qwen3-vl-embedding=2560
VECTOR_DIM=1024
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB=default
MILVUS_COLLECTION=gov_docs
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION=gov_docs
CHROMA_HOST=
CHROMA_PORT=8000

# ================= Embedding =================
# hash             = 本地哈希向量（离线可跑，语义能力弱，仅用于演示）
# openai           = OpenAI 兼容接口
# dashscope        = 阿里通义千问（OpenAI 兼容模式，text-embedding-v3）
# dashscope_native = 阿里通义千问多模态原生接口（qwen3-vl-embedding，2560 维）
#                    注意：该模型不支持 OpenAI 兼容模式，必须走原生端点
EMBEDDING_PROVIDER=dashscope
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBED_MODEL=text-embedding-3-small
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBED_MODEL=qwen3.7-text-embedding-flash
DASHSCOPE_NATIVE_EMBED_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding
EMBED_WORKERS=6
EMBED_TIMEOUT=30        # 独立于 LLM_TIMEOUT，避免单次挂起拖死请求线程

# ================= 大模型 =================
# extractive = 抽取式兜底（无需额外额度，严格依据检索片段生成）
# dashscope  = 通义千问（与 Embedding 共用同一个 Key）
# openai     = OpenAI 兼容接口
LLM_PROVIDER=extractive
OPENAI_MODEL=gpt-4o-mini
DASHSCOPE_MODEL=deepseek-v4.1-flash
TEMPERATURE=0.2
# 推理类模型（qwen3.x）单次可达数十秒，超时需放宽
LLM_TIMEOUT=300
# 是否开启推理类模型的"深度思考"；deepseek-v4.1-flash 恒开思考，此处保持 true
LLM_ENABLE_THINKING=true
# 思考模式下限制思考 token 数（qwen3 的 thinking_budget）。
# 不限制时单轮实测 140s+；给 1024 后降到 10s 量级。0 = 不传该参数
# deepseek-v4.1-flash 不支持该参数（服务端忽略），故置 0
LLM_THINKING_BUDGET=0

# ================= RAG 参数 =================
TOP_K=4
SIMILARITY_THRESHOLD=0.22
# 相关性闸门：以向量余弦为主判据，关键词阈值设高以免长文档把无关问题抬上来
# 与 Embedding 模型强绑定（当前 qwen3.7-text-embedding-flash / 1024 维 / 841 片段），
# 换模型或换语料后用 scripts/calibrate_gate.py + scripts/probe_gate.py 重标
KEYWORD_MIN_SCORE=44.3
VECTOR_MIN_SCORE=0.45
FUSED_MIN_SCORE=0.62
VAGUE_VECTOR_MAX=0.50
MAX_HISTORY_TURNS=5
MAX_CONTEXT_CHARS=3000
MAX_QUESTION_LEN=1000

# ================= 离线预处理 =================
CHUNK_SIZE=500
CHUNK_OVERLAP=100
DOCS_DIR=data/docs
# 知识库已由 scripts/import_existing_vectors.py 灌入真实语料时置为 false
AUTO_INGEST_ON_STARTUP=false

# ================= 工作台：语料自助增删 =================
# 用户上传语料的落盘目录（与内置语料分开，内置语料在容器里是只读挂载）
UPLOAD_DIR=data/uploads
# 单个上传文件大小上限（MB）
MAX_UPLOAD_MB=10
# 工作台访问凭证：留空 = 不校验（内网/演示部署）；
# 一旦填写，/api/corpus 全部接口都要求请求头 X-Workbench-Token 与之相同。
# 前端对应配置 VITE_WORKBENCH_TOKEN（同一个值）。
CORPUS_WRITE_TOKEN=
