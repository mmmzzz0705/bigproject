# 复制为 .env 后按需修改（docker compose 会自动读取）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=gov_qa

# 向量维度需与 Embedding 模型一致
#   hash / text-embedding-v3       -> 1024
#   qwen3-vl-embedding（多模态）   -> 2560
VECTOR_DIM=1024

# AI 应用层：native / langchain
PIPELINE=native

# 模型提供方：extractive（无需密钥）/ openai / dashscope
EMBEDDING_PROVIDER=dashscope
LLM_PROVIDER=dashscope
DASHSCOPE_EMBED_MODEL=qwen3.7-text-embedding-flash
DASHSCOPE_MODEL=deepseek-v4.1-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DASHSCOPE_API_KEY=sk-xxxxxxxx

# deepseek-v4.1-flash 原生思考模型，服务端恒开思考链
LLM_TIMEOUT=300
LLM_ENABLE_THINKING=true
LLM_MAX_TOKENS=4096
# deepseek 不支持 thinking_budget；仅 qwen 系生效
LLM_THINKING_BUDGET=0

# 相关性闸门（务必与 Embedding 模型配套，换模型后用 scripts/calibrate_gate.py 重标）
#   当前：qwen3.7-text-embedding-flash / 1024 维 / 841 片段 -> 0.45 / 44.3 / 0.62 / 0.60
#   历史：2560 维 qwen3-vl-embedding -> 0.55 / 25.0
VECTOR_MIN_SCORE=0.45
KEYWORD_MIN_SCORE=44.3
FUSED_MIN_SCORE=0.62
VAGUE_VECTOR_MAX=0.50

# 复用宿主机已有服务（而非 compose 里的 postgres/milvus）时：
#   1) 用 docker-compose.host.yml 编排（只起后端前端）
#   2) 打开下面三行，端口按宿主机实际情况填
# DB_HOST=host.docker.internal
# DB_PORT=5433
# MILVUS_HOST=host.docker.internal
# MILVUS_PORT=19530

# 宿主向量库已有语料时设为 false，避免启动时重复导入
AUTO_INGEST_ON_STARTUP=false

# ---- 工作台（语料自助增删）----
# 留空 = 不校验；填写后 /api/corpus 全部接口要求请求头 X-Workbench-Token
# （前端 VITE_WORKBENCH_TOKEN 填同一个值）
CORPUS_WRITE_TOKEN=
